spring.application.name=ambulance-service-api

# PostgreSQL Configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/ambulance_db
spring.datasource.username=ambulance_user
spring.datasource.password=<YOUR_DATABASE_PASSWORD_HERE>
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Super Admin User (created on first startup)
app.superadmin.email=superadmin@example.com
app.superadmin.password=<YOUR_SUPERADMIN_PASSWORD_HERE>
app.superadmin.phone=+1664523112

# Registration rules
app.registration.admin-invite-code=<YOUR_ADMIN_INVITE_CODE_HERE>

# JWT Properties
app.jwt.secret=<YOUR_RANDOM_32+_CHAR_SECRET_HERE>
app.jwt.expiration-ms=86400000

# Static resource cache control (helpful during frontend/module refactors)
spring.web.resources.cache.cachecontrol.no-cache=true
spring.web.resources.cache.cachecontrol.must-revalidate=true

# Driver availability settings
app.driver.availability.max-stale-minutes=1440

# HTTP proxy for outbound geocoding / internet calls
app.http.proxy.enabled=false
app.http.proxy.host=
app.http.proxy.port=8080
app.http.proxy.username=
app.http.proxy.password=
